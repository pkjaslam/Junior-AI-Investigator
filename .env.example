# Optional. The app runs fully without any key (briefs and answers are built from the case data).
# Copy this file to .env and fill in ONE provider. Never commit .env.

# NVIDIA NIM (free developer key from build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# or OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# or any other OpenAI-compatible endpoint (Anthropic, Groq, Together, a local Ollama or vLLM server ...)
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# LLM_TIMEOUT_S=40
